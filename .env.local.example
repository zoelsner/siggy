BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token_from_dashboard

# Stripe keys come from the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_your_secret_key_from_stripe_dashboard
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_from_stripe_dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_from_stripe_dashboard

# Run `STRIPE_SECRET_KEY=sk_test_... npm run stripe:setup-product` once, then
# store the returned IDs here and in Vercel.
STRIPE_PRODUCT_ID=prod_created_by_stripe_setup_product
STRIPE_PRICE_ID=price_created_by_stripe_setup_product
# Optional: only verified historical Siggy identities on a different product.
# Prices on the current configured price's product are recognized automatically.
SIGGY_LEGACY_PRICE_IDS=
SIGGY_LEGACY_PRODUCT_IDS=

SIGGY_TOKEN_SECRET=replace_with_a_32_byte_hex_secret
SIGGY_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=zachoelsner@gmail.com
